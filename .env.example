# UX Assistant — environment variables
# Copy to .env and fill in your values. Never commit .env.

# Figma credentials
FIGMA_PAT=                        # Personal Access Token (Settings > Security > Tokens)
FIGMA_TEAM_ID=                    # Team ID (visible in the Figma URL: figma.com/files/team/{ID})

# Figma file keys (extract from file URL: figma.com/design/{FILE_KEY}/...)
FIGMA_DS_FILE_KEY=                # Design System library file key
FIGMA_PROJECT_FILE_KEY=           # Main product file key (optional default)

# Notion (optional — for publishing handoffs and reports)
NOTION_HANDOFF_DB_ID=             # Notion database ID for handoff pages
NOTION_AUDIT_DB_ID=               # Notion database ID for audit reports

# Slack (optional — for notifications)
SLACK_DESIGN_CHANNEL=             # e.g. #design-handoff
SLACK_ENG_CHANNEL=                # e.g. #frontend
